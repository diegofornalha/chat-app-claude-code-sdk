    "stress_test_messages": [
      {
        "id": "stress-template",
        "type": "send_message",
        "messageData": {
          "message": "Mensagem de teste de stress número {INDEX}",
          "sessionId": "session-stress-{INDEX}"
        },
        "priority": "normal",
        "description": "Template para gerar múltiplas mensagens de stress test"
      }
    ]
  },
  "test_scenarios": {
    "scenario_1_basic_queue": {
      "name": "Teste Básico de Fila",
      "description": "Testar funcionalidade básica de enqueue e dequeue",
      "messages": ["basic-1", "basic-2", "basic-3"],
      "expected_order": [1, 2, 3],
      "timeout": 30000
    },
    "scenario_2_priority": {
      "name": "Teste de Prioridade",
      "description": "Testar se mensagens de alta prioridade são processadas primeiro",
      "messages": ["basic-1", "priority-1", "basic-2"],
      "expected_order": [2, 1, 3],
      "timeout": 30000
    },
    "scenario_3_mixed_types": {
      "name": "Teste de Tipos Mistos",
      "description": "Testar diferentes tipos de mensagem",
      "messages": ["basic-1", "context-1", "a2a-1"],
      "expected_order": [3, 1, 2],
      "timeout": 45000
    },
    "scenario_4_error_handling": {
      "name": "Teste de Tratamento de Erro",
      "description": "Testar como o sistema lida com mensagens inválidas",
      "messages": ["basic-1", "error-1", "basic-2"],
      "expected_errors": ["error-1"],
      "timeout": 30000
    },
    "scenario_5_batch_processing": {
      "name": "Teste de Processamento em Lote", 
      "description": "Testar processamento de múltiplas mensagens",
      "messages": ["batch-1", "batch-2", "batch-3", "batch-4", "batch-5"],
      "expected_order": [1, 2, 3, 4, 5],
      "timeout": 60000
    },
    "scenario_6_stress_test": {
      "name": "Teste de Stress",
      "description": "Testar o sistema sob alta carga",
      "message_template": "stress-template",
      "message_count": 50,
      "timeout": 120000
    }
  },
  "queue_limits": {
    "max_queue_size": 100,
    "message_timeout": 300000,
    "max_concurrent_processing": 1,
    "retry_attempts": 3,
    "retry_delay": 1000
  },
  "validation_rules": {
    "message_structure": {
      "required_fields": ["type", "messageData"],
      "optional_fields": ["priority"],
      "valid_types": [
        "send_message",
        "send_message_with_context", 
        "a2a:send_message"
      ],
      "valid_priorities": ["normal", "high"]
    },
    "messageData_structure": {
      "required_fields": ["message"],
      "optional_fields": ["sessionId", "context", "targetAgent", "sourceAgent"]
    }
  }
}