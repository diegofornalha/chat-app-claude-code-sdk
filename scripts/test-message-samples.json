      {
        "id": "batch-2", 
        "type": "send_message",
        "messageData": {
          "message": "Segunda mensagem do lote de testes",
          "sessionId": "session-batch-1"
        },
        "priority": "normal",
        "batchIndex": 2
      },
      {
        "id": "batch-3",
        "type": "send_message",
        "messageData": {
