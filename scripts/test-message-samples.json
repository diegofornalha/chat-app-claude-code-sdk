        "batchIndex": 3
      },
      {
        "id": "batch-4",
        "type": "send_message",
        "messageData": {
          "message": "Quarta mensagem do lote de testes",
          "sessionId": "session-batch-1"
        },
        "priority": "normal",
        "batchIndex": 4
      },
      {
        "id": "batch-5",
        "type": "send_message",
        "messageData": {
